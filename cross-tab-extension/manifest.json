{
  "manifest_version": 3,
  "name": "Cross-Device Tab Sync",
  "version": "1.0.0",
  "description": "Sync open tabs between your Mac and iPhone via Chrome Bookmarks",
  "permissions": ["tabs", "bookmarks"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
